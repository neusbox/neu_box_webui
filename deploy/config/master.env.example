# Neu Box Master runtime configuration

NEU_BOX_LISTEN=0.0.0.0
NEU_BOX_PORT=25565
NEU_BOX_HTTP_THREADS=8
NEU_BOX_POLL_INTERVAL=15

# Persistent paths are optional. Without overrides, WebUI uses the current
# user's XDG config/data/state directories. Uncomment these paths for the
# systemd example in deploy/systemd/neu-box-webui.service.
# NEU_BOX_DB_PATH=/var/lib/neu-box/master/master.db
# NEU_BOX_NODES_CONFIG=/etc/neu-box/nodes.json
# NEU_BOX_UPLOAD_DIR=/var/lib/neu-box/master/uploads
# NEU_BOX_EXPERIMENT_LOG_DIR=/var/lib/neu-box/master/experiment-logs
# NEU_BOX_LOG_DIR=/var/log/neu-box
# NEU_BOX_BACKUP_DIR=/var/backups/neu-box

LOG_LEVEL=INFO

# Set stable production values before first start. An empty SECRET_KEY is
# replaced by a temporary value on every process start, invalidating sessions.
SECRET_KEY=
ADMIN_USER=admin
ADMIN_PASS=admin

# Maximum uploaded experiment image size in bytes (10 MiB).
NEU_BOX_UPLOAD_MAX_SIZE=10485760
