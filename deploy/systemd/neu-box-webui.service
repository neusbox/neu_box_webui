[Unit]
Description=Neu Box WebUI (master)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=neu-box
Group=neu-box
WorkingDirectory=/opt/neu-box/webui
EnvironmentFile=/opt/neu-box/webui/runtime/config/webui.env
ExecStart=/opt/neu-box/webui/.venv/bin/python -m neu_box_webui.master.app --config /opt/neu-box/webui/runtime/config/webui.env serve
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/neu-box/webui/runtime

[Install]
WantedBy=multi-user.target
